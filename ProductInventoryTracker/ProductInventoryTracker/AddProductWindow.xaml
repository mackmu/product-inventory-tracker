<Window x:Class="ProductInventoryTracker.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductInventoryTracker"
        mc:Ignorable="d"
        Title="ProductWindow" Height="650" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Width="350" Margin="0,41,0,0">

            <TextBlock Text="Add Product" FontSize="17" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <Label Content="Product Name"/>
            <TextBox x:Name="txtProductName" HorizontalAlignment="Left" Margin="0,0,0,10" Width="210"/>
            <Label Content="Price"/>
            <TextBox x:Name="txtPrice" Width="66" HorizontalAlignment="Left" Margin="0,0,0,10"/>

            <Label Content="Quantity"/>
            <TextBox x:Name="txtQuantity" Width="65" HorizontalAlignment="Left" Margin="0,0,0,15"/>

            <Label Content="Category"/>
            <ComboBox x:Name="cmbCategory" Width="150" HorizontalAlignment="Left" Margin="0,0,0,10"
                  DisplayMemberPath="CategoryName" SelectedValuePath="CategoryID"/>

            <Label Content="Supplier"/>
            <ComboBox x:Name="cmbSupplier" Width="150" HorizontalAlignment="Left" Margin="0,0,0,10"
                  DisplayMemberPath="SupplierName" SelectedValuePath="SupplierID"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,30,0,25">
                <Button x:Name="btnCalculate" Content="Calculate Subtotal" Width="110" 
                        HorizontalAlignment="Left" Click="btnCalculate_Click"/>
                <Label Content=" Total added to inventory is" FontWeight="Bold"/>
                <TextBlock x:Name="lblSubtotalDisplay" Text="$0.00" VerticalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="btnSaveProduct" Content="Save" Width="80" Height="30" 
                HorizontalAlignment="Left" Margin="0,10,0,10" Click="btnSaveProduct_Click"/>

        </StackPanel>
    </Grid>
</Window>
