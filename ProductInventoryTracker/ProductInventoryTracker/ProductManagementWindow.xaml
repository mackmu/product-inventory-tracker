<Window x:Class="ProductInventoryTracker.ProductManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductInventoryTracker"
        mc:Ignorable="d"
        Title="ProductManagementWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Products" FontSize="16" Margin="0,0,0,5"/>

        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1">
            <DataGrid x:Name="dgProducts" ItemsSource="{Binding ProductList}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" 
                      RowBackground="White" AlternatingRowBackground="#F0F0F0" GridLinesVisibility="Horizontal" 
                      HorizontalGridLinesBrush="LightGray" ColumnWidth="*">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Model" Binding="{Binding ProductName}" Width="2*" />
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" />
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Subtotal, StringFormat=C}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="btnAdd" Content="Add" Width="100" Margin="5,0" Click="btnAdd_Click"/>
            <Button x:Name="btnEdit" Content="Edit" Width="100" Margin="5,0" Click="btnEdit_Click"/>
            <Button x:Name="btnDelete" Content="Delete" Width="100" Margin="5,0" Click="btnDelete_Click"/>
        </StackPanel>
    </Grid>
</Window>
