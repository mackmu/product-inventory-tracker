<Window x:Class="ProductInventoryTracker.CategoryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductInventoryTracker"
        mc:Ignorable="d"
        Title="CategoryManagementWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Categories" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>

            <DataGrid x:Name="dgCategories" AutoGenerateColumns="False" IsReadOnly="True" 
                      Height="250" ItemsSource="{Binding CategoryList}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Category ID" Binding="{Binding CategoryID}" Width="150"/>
                    <DataGridTextColumn Header="Category Name" Binding="{Binding CategoryName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="btnAdd" Content="Add" Width="100" Margin="5,0" Click="btnAdd_Click"/>
                <Button x:Name="btnEdit" Content="Edit" Width="100" Margin="5,0" Click="btnEdit_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
