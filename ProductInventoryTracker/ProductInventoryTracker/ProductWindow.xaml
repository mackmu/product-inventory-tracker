<Window x:Class="ProductInventoryTracker.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductInventoryTracker"
        mc:Ignorable="d"
        Title="ProductWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">

            <TextBlock Text="Add Product" FontSize="17" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <Label Content="Product Name"/>
            <TextBox x:Name="txtProductName" Margin="0,0,0,10"/>

            <Label Content="Price"/>
            <TextBox x:Name="txtPrice" Width="66" HorizontalAlignment="Left" Margin="0,0,0,10"/>

            <Label Content="Quantity"/>
            <TextBox x:Name="txtQuantity" Width="65" HorizontalAlignment="Left" Margin="0,0,0,15"/>

            <Button x:Name="btnCalculate" Content="Calculate Subtotal" Width="150" 
                HorizontalAlignment="Center" Margin="0,20,0,10" Click="btnCalculate_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                <Label Content="Product Subtotal: " FontWeight="Bold"/>
                <TextBlock x:Name="lblSubtotalDisplay" Text="$0.00" VerticalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="btnSaveProduct" Content="Save" Width="80" Height="30" 
                HorizontalAlignment="Center" Margin="0,10,0,10" Click="btnSaveProduct_Click"/>

        </StackPanel>
    </Grid>
</Window>
