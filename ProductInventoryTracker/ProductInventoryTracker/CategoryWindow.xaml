<Window x:Class="ProductInventoryTracker.CategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductInventoryTracker"
        mc:Ignorable="d"
        Title="CategoryWindow" Height="450" Width="800">
    <Grid>
        <TextBlock HorizontalAlignment="Left" Margin="112,58,0,0" TextWrapping="Wrap" Text="Add Category" FontSize="17" FontWeight="Bold" VerticalAlignment="Top"/>
        <Label Content="Category Name" HorizontalAlignment="Left" Margin="112,106,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtCategoryName" HorizontalAlignment="Left" Margin="205,110,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="169"/>
        <Button x:Name="btnAddCategory" Content="Add" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="380,110,0,0" VerticalAlignment="Top" Height="18" Width="48" Click="btnAddCategory_Click"/>
    </Grid>
</Window>
