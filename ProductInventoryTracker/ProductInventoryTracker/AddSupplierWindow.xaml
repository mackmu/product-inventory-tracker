<Window x:Class="ProductInventoryTracker.AddSupplierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductInventoryTracker"
        mc:Ignorable="d"
        Title="AddSupplierWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">

            <TextBlock Text="Add Supplier" FontSize="17" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <Label Content="Supplier Name"/>
            <TextBox x:Name="txtSupplierName" Margin="0,0,0,10"/>

            <Label Content="Email"/>
            <TextBox x:Name="txtSupplierEmail" Margin="0,0,0,10"/>

            <Label Content="Phone number"/>
            <TextBox x:Name="txtSupplierPhone" MaxLength="14" Margin="0,0,0,25" 
                 TextChanged="txtSupplierPhone_TextChanged"/>

            <Button x:Name="btnSaveSupplier" Content="Save" Width="80" Height="30" 
                HorizontalAlignment="Center" Click="btnSaveSupplier_Click"/>

        </StackPanel>
    </Grid>
</Window>
