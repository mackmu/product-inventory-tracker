<Window x:Class="ProductInventoryTracker.SupplierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductInventoryTracker"
        mc:Ignorable="d"
        Title="SupplierWindow" Height="450" Width="800">
    <Grid>
        <TextBlock HorizontalAlignment="Left" Margin="112,58,0,0" TextWrapping="Wrap" Text="Add Supplier" FontSize="17" FontWeight="Bold" VerticalAlignment="Top"/>
        <Label Content="Supplier Name" HorizontalAlignment="Left" Margin="112,106,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtSupplierName" HorizontalAlignment="Left" Margin="203,110,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="210"/>
        <Label Content="Email" HorizontalAlignment="Left" Margin="163,136,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtSupplierEmail" HorizontalAlignment="Left" Margin="204,140,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="209"/>
        <Button x:Name="btnSaveSupplier" Content="Save" HorizontalAlignment="Left" Margin="400,237,0,0" VerticalAlignment="Top" Height="27" Width="58" Click="btnSaveSupplier_Click"/>
    </Grid>
</Window>
